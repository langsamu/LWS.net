@prefix : <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    :manifestName "Ported from manifest.jsonld: LWS Protocol 1.0 Test Suite" ;
    :test
        _:storageContentTypeIsLwsCid ,
        _:storageRootIsContainer ,
        _:storageRootIsContainerStatus ,
        _:storageRootIsContainerTypeLink ,
        _:discoveryStorageDescriptionStatus ,
        _:discoveryStorageDescriptionContentType ,
        _:discoveryGetLinksStorageDescriptionStatus ,
        _:getContainerReturns200 ,
        _:getContainerReturnsLwsJsonMediaType ,
        _:getContainerLinksContainerType ,
        _:readDataResourceReturns200 ,
        _:readDataResourceReturnsTextPlain ,
        _:readDataResourceLinksDataResourceType ,
        _:readDataResourceReturnsBody ,
        _:getLinksetReturns200 ,
        _:getLinksetReturnsLinksetJsonMediaType ,
        _:containerWithMemberReturns200 ,
        _:containerWithMemberReturnsLwsJsonMediaType ,
        _:authorizationServerMetadataReturns200 ,
        _:authorizationServerMetadataReturnsJsonMediaType ,
        _:tokenExchangeForUnknownResourceReturns400 ;
    :include "oldmanifest/did_key.ttl"^^xsd:anyURI ;
] .

# Tests

_:storageContentTypeIsLwsCid
    :testName "Storage content-type is LWS CID" ;
    :steps (
        _:getStorageContentType
    ) ;
    :assert _:lwsCidContentType ;
.

_:storageRootIsContainer
    :testName "Storage root is container" ;
    :steps (
        _:getStorageFirst
        _:getStorageTypeLinks
    ) ;
    :assert _:containerTypeLink ;
.

_:storageRootIsContainerStatus
    :testName "storage-root-is-container-status" ;
    :steps (
        _:getStorageStatus
    ) ;
    :assert _:200 ;
.

_:storageRootIsContainerTypeLink
    :testName "storage-root-is-container-type-link" ;
    :steps (
        _:getStorageTypeLinks
    ) ;
    :assert _:containerTypeLink ;
.

_:discoveryStorageDescriptionStatus
    :testName "discovery-storage-description-status" ;
    :steps (
        _:getStorageAsLwsJsonStatus
    ) ;
    :assert _:200 ;
.

_:discoveryStorageDescriptionContentType
    :testName "discovery-storage-description-content-type" ;
    :steps (
        _:getStorageAsLwsJsonContentType
    ) ;
    :assert _:lwsJsonContentType ;
.

_:discoveryGetLinksStorageDescriptionStatus
    :testName "discovery-get-links-storageDescription-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerStatus
    ) ;
    :assert _:200 ;
.

_:getContainerReturns200
    :testName "getContainer-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerAsLwsJsonStatus
    ) ;
    :assert _:200 ;
.

_:getContainerReturnsLwsJsonMediaType
    :testName "getContainer-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerAsLwsJsonContentType
    ) ;
    :assert _:lwsJsonContentType ;
.

_:getContainerLinksContainerType
    :testName "getContainer-type-link" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerAsLwsJsonTypeLinks
    ) ;
    :assert _:containerTypeLink ;
.

_:readDataResourceReturns200
    :testName "readDataResource-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListStatus
    ) ;
    :assert _:200 ;
.

_:readDataResourceReturnsTextPlain
    :testName "readDataResource-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListContentType
    ) ;
    :assert _:textPlainContentType ;
.

_:readDataResourceLinksDataResourceType
    :testName "readDataResource-type-link" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListTypeLinks
    ) ;
    :assert _:dataResourceTypeLink ;
.

_:readDataResourceReturnsBody
    :testName "readDataResource-body" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListBody
    ) ;
    :assert [
        :that [
            :variable "body" ;
        ] ;
        :equals [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
.

_:getLinksetReturns200
    :testName "getLinkset-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerLinksetLinks
        _:getLinksetStatus
    ) ;
    :assert _:200 ;
.

_:getLinksetReturnsLinksetJsonMediaType
    :testName "getLinkset-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerLinksetLinks
        _:getLinksetContentType
    ) ;
    :assert [
        :that [
            :single [
                :variable "contentType" ;
            ] ;
        ] ;
        :matches [ :constant "(?i)^application/linkset\\+json\\s*(;|$)" ] ;
    ] ;
.

_:containerWithMemberReturns200
    :testName "getContainer-containmentIntegrity-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getContainerAsLwsJsonStatus
    ) ;
    :assert _:200 ;
.

_:containerWithMemberReturnsLwsJsonMediaType
    :testName "getContainer-containmentIntegrity-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getContainerAsLwsJsonContentType
    ) ;
    :assert _:lwsJsonContentType ;
.

_:authorizationServerMetadataReturns200
    :testName "authz-server-metadata-well-known-status" ;
    :steps (
        _:discoverAuthorizationServer
        _:getAuthorizationServerMetadataStatus
    ) ;
    :assert _:200 ;
.

_:authorizationServerMetadataReturnsJsonMediaType
    :testName "authz-server-metadata-well-known-content-type" ;
    :steps (
        _:discoverAuthorizationServer
        _:getAuthorizationServerMetadataContentType
    ) ;
    :assert [
        :that [
            :single [
                :variable "contentType" ;
            ] ;
        ] ;
        :matches [ :constant "(?i)^application/json\\s*(;|$)" ] ;
    ] ;
.

_:tokenExchangeForUnknownResourceReturns400
    :testName "authz-token-exchange-invalid-resource-status" ;
    :steps (
        _:discoverAuthorizationServer
        _:exchangeTokenForUnknownResourceStatus
    ) ;
    :assert [
        :that [
            :variable "status" ;
        ] ;
        :equals [ :constant "400" ] ;
    ] ;
.

# Steps

_:getStorageFirst
    :stepName "Get storage first" ;
    :request _:getStorage ;
    :extract () ;
.

_:getStorageContentType
    :stepName "Get storage Content-Type" ;
    :request _:getStorage ;
    :extract (
        _:contentType
    ) ;
.

_:getStorageTypeLinks
    :stepName "Get storage type links" ;
    :request _:getStorage ;
    :extract (
        _:typeLinks
    ) ;
.

_:getStorageStatus
    :stepName "Get storage status" ;
    :request _:getStorage ;
    :extract (
        _:status
    ) ;
.

_:getStorageAsLwsJsonStatus
    :stepName "Get storage as LWS JSON status" ;
    :request _:getStorageAsLwsJson ;
    :extract (
        _:status
    ) ;
.

_:getStorageAsLwsJsonContentType
    :stepName "Get storage as LWS JSON Content-Type" ;
    :request _:getStorageAsLwsJson ;
    :extract (
        _:contentType
    ) ;
.

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request _:getStorage ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "containerLocation" ;
        ]
    ) ;
.

_:getContainerStatus
    :stepName "Get container status" ;
    :request _:getContainer ;
    :extract (
        _:status
    ) ;
.

_:getContainerAsLwsJsonStatus
    :stepName "Get container as LWS JSON status" ;
    :request _:getContainerAsLwsJson ;
    :extract (
        _:status
    ) ;
.

_:getContainerAsLwsJsonContentType
    :stepName "Get container as LWS JSON Content-Type" ;
    :request _:getContainerAsLwsJson ;
    :extract (
        _:contentType
    ) ;
.

_:getContainerAsLwsJsonTypeLinks
    :stepName "Get container as LWS JSON type links" ;
    :request _:getContainerAsLwsJson ;
    :extract (
        _:typeLinks
    ) ;
.

_:createShoppingList
    :stepName "Create shopping list" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "shoppingListLocation" ;
        ]
    ) ;
.

_:getShoppingListStatus
    :stepName "Get shopping list status" ;
    :request _:getShoppingList ;
    :extract (
        _:status
    ) ;
.

_:getShoppingListContentType
    :stepName "Get shopping list Content-Type" ;
    :request _:getShoppingList ;
    :extract (
        _:contentType
    ) ;
.

_:getShoppingListTypeLinks
    :stepName "Get shopping list type links" ;
    :request _:getShoppingList ;
    :extract (
        _:typeLinks
    ) ;
.

_:getShoppingListBody
    :stepName "Get shopping list body" ;
    :request _:getShoppingList ;
    :extract (
        _:body
    ) ;
.

_:getContainerLinksetLinks
    :stepName "Get container linkset links" ;
    :request _:getContainer ;
    :extract (
        [
            :link "linkset" ;
            :to "linksetLinks" ;
        ]
    ) ;
.

_:getLinksetStatus
    :stepName "Get linkset status" ;
    :request _:getLinkset ;
    :extract (
        _:status
    ) ;
.

_:getLinksetContentType
    :stepName "Get linkset Content-Type" ;
    :request _:getLinkset ;
    :extract (
        _:contentType
    ) ;
.

_:discoverAuthorizationServer
    :stepName "Discover authorization server" ;
    :request _:getStorage ;
    :extract (
        [
            :path "$.service[?@.type == 'AuthorizationServer'].serviceEndpoint" ;
            :to "authorizationServer" ;
        ]
    ) ;
.

_:getAuthorizationServerMetadataStatus
    :stepName "Get authorization server metadata status" ;
    :request _:getAuthorizationServerMetadata ;
    :extract (
        _:status
    ) ;
.

_:getAuthorizationServerMetadataContentType
    :stepName "Get authorization server metadata Content-Type" ;
    :request _:getAuthorizationServerMetadata ;
    :extract (
        _:contentType
    ) ;
.

_:exchangeTokenForUnknownResourceStatus
    :stepName "Exchange token for unknown resource status" ;
    :request [
        :method "POST" ;
        :uri _:tokenEndpoint ;
        :headers _:contentTypeFormUrlEncoded ;
        :body [ :constant "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Atoken-exchange&resource=https%3A%2F%2Funknown.example%2F&subject_token_type=urn%3Aietf%3Aparams%3Aoauth%3Atoken-type%3Aid_token&subject_token=<subject-token>" ] ;
    ] ;
    :extract (
        _:status
    ) ;
.

# Requests

_:getStorage
    :method "GET" ;
    :uri _:storage ;
.

_:getStorageAsLwsJson
    :method "GET" ;
    :uri _:storage ;
    :headers _:acceptLwsJson ;
.

_:getContainer
    :method "GET" ;
    :uri _:container ;
.

_:getContainerAsLwsJson
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getShoppingList
    :method "GET" ;
    :uri _:shoppingList ;
.

_:getLinkset
    :method "GET" ;
    :uri [
        :single [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/linkset+json" ] ;
    ] ;
.

_:getAuthorizationServerMetadata
    :method "GET" ;
    :uri [
        :base _:authorizationServer ;
        :relative [
            :constant "/.well-known/lws-configuration" ;
        ] ;
    ] ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/json" ] ;
    ] ;
.

# URIs

_:storage
    :variable "baseUri" ;
.

_:storageRoot
    :single [
        :variable "storageRoot" ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:shoppingList
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "shoppingListLocation" ;
        ] ;
    ] ;
.

_:authorizationServer
    :single [
        :variable "authorizationServer" ;
    ] ;
.

_:tokenEndpoint
    :base _:authorizationServer ;
    :relative [
        :constant "/token" ;
    ] ;
.

# Headers

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

_:contentTypeFormUrlEncoded
    :key "Content-Type" ;
    :value [ :constant "application/x-www-form-urlencoded" ] ;
.

# Extractors

_:contentType
    :header "Content-Type" ;
    :to "contentType" ;
.

_:typeLinks
    :link "type" ;
    :to "typeLinks" ;
.

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:body
    a :BodyExtractor ;
    :to "body" ;
.

# Assertions

_:lwsCidContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/lws\\+cid\\s*(;|$)" ] ;
.

_:containerTypeLink
    :that [
        :variable "typeLinks" ;
    ] ;
    :contains [ :constant "https://www.w3.org/ns/lws#Container" ] ;
.

_:200
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "200" ] ;
.

_:lwsJsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/lws\\+json\\s*(;|$)" ] ;
.

_:textPlainContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^text/plain\\s*(;|$)" ] ;
.

_:dataResourceTypeLink
    :that [
        :variable "typeLinks" ;
    ] ;
    :contains [ :constant "https://www.w3.org/ns/lws#DataResource" ] ;
.
