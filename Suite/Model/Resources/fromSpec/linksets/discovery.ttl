@prefix : <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    :manifestName "From specification: Linked Web Storage Protocol 1.0: Linksets: Discovery" ;
    :test
        _:metadataLinksAreAvailableAsStandaloneResource ,
        _:containerMetadataLinksAreAvailableAsStandaloneResource ,
        _:linksetIsDiscoverableViaLinkHeaderWithRelLinkset ,
        _:containerLinksetIsDiscoverableViaLinkHeaderWithRelLinkset ,
        _:linksetResourceIsAvailableAsApplicationLinksetJson ,
        _:linksetResourceBodyIsRfc9264Linkset ;
] .

# Tests

_:metadataLinksAreAvailableAsStandaloneResource
    :testName "Metadata links are available as a standalone resource" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetStatus
    ) ;
    :assert _:200 ;
.

_:containerMetadataLinksAreAvailableAsStandaloneResource
    :testName "Container metadata links are available as standalone resource" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerLinksetLinks
        _:getLinksetStatus
    ) ;
    :assert _:200 ;
.

_:linksetIsDiscoverableViaLinkHeaderWithRelLinkset
    :testName "Linkset is discoverable via Link header with rel linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
    ) ;
    :assert _:linksetLink ;
.

_:containerLinksetIsDiscoverableViaLinkHeaderWithRelLinkset
    :testName "Container linkset is discoverable via Link header with rel linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerLinksetLinks
    ) ;
    :assert _:linksetLink ;
.

_:linksetResourceIsAvailableAsApplicationLinksetJson
    :testName "Linkset resource is available as application/linkset+json" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetContentType
    ) ;
    :assert _:linksetJsonContentType ;
.

_:linksetResourceBodyIsRfc9264Linkset
    :testName "Linkset resource body is RFC 9264 linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetMembers
    ) ;
    :assert [
        :that [
            :count [
                :variable "linksetMembers" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

# Steps

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot' || @.type[?@ == 'StorageRoot']].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        _:textResourceLocation
    ) ;
.

_:getTextResourceLinksetLinks
    :stepName "Get text resource linkset links" ;
    :request _:getTextResource ;
    :extract (
        _:linksetLinks
    ) ;
.

_:getLinksetStatus
    :stepName "Get linkset status" ;
    :request _:getLinkset ;
    :extract (
        _:status
    ) ;
.

_:getContainerLinksetLinks
    :stepName "Get container linkset links" ;
    :request _:getContainer ;
    :extract (
        _:linksetLinks
    ) ;
.

_:getLinksetContentType
    :stepName "Get linkset Content-Type" ;
    :request _:getLinkset ;
    :extract (
        _:contentType
    ) ;
.

_:getLinksetMembers
    :stepName "Get linkset members" ;
    :request _:getLinkset ;
    :extract (
        [
            :path "$.linkset[*]" ;
            :to "linksetMembers" ;
        ]
    ) ;
.

# Requests

_:getStorageDescription
    :method "GET" ;
    :uri _:storage ;
.

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getLinkset
    :method "GET" ;
    :uri _:linkset ;
    :headers _:acceptLinksetJson ;
.

# URIs

_:storage
    :variable "baseUri" ;
.

_:storageRoot
    :base _:storage ;
    :relative [
        :single [
            :variable "storageRoot" ;
        ] ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:container ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

_:linkset
    :single [
        :variable "linksetLinks" ;
    ] ;
.

# Headers

_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

_:acceptLinksetJson
    :key "Accept" ;
    :value [ :constant "application/linkset+json" ] ;
.

# Extractors

_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:textResourceLocation
    :header "Location" ;
    :to "textResourceLocation" ;
.

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:contentType
    :header "Content-Type" ;
    :to "contentType" ;
.

_:linksetLinks
    :link "linkset" ;
    :to "linksetLinks" ;
.

# Assertions

_:200
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "200" ] ;
.

_:linksetLink
    :that [
        :count [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :greaterThan [ :constant 0 ] ;
.

_:linksetJsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/linkset\\+json\\s*(;|$)" ] ;
.
