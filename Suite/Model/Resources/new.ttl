@prefix : <http://example.com/> .

[
    :name "LWS Test Suite" ;
    :tests (
        _:test1
        _:test2
        _:core-containers-getContainer-status
        _:core-data_resources-createDataResource-body
        _:core-data_resources-data-resource-range-unsatisfiable
        _:core-containers-createContainer-items-empty
        _:core-data_resources-data-resource-range-request-first-status
        _:core-containers-getContainer-containmentIntegrity-initial-items-empty
        _:core-data_resources-data-resource-range-request-suffix-status
    ) ;
] .

_:test1
    :name "Test1" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
        _:getCreatedResource
    ) ;
    :assertion _:404 ;
.

_:test2
    :name "Test2" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
    ) ;
    :assertion _:999 ; # Intentionally bogus
.

_:core-containers-getContainer-status
    :name "getContainer-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
    ) ;
    :assertion _:200 ;
.

_:core-data_resources-createDataResource-body
    :name "createDataResource-body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceBody
    ) ;
    :assertion _:shoppingListBody ;
.

_:core-data_resources-data-resource-range-unsatisfiable
    :name "Data resource range unsatisfiable" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceBeyondEnd
    ) ;
    :assertion _:416 ;
.

_:core-containers-createContainer-items-empty
    :name "createContainer-items-empty" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createSubContainer
        _:getContainerItems
    ) ;
    :assertion _:emptyItems ;
.

_:core-data_resources-data-resource-range-request-first-status
    :name "data-resource-range-request-first-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceFirstBytes
    ) ;
    :assertion _:206 ;
.

_:core-containers-getContainer-containmentIntegrity-initial-items-empty
    :name "getContainer-containmentIntegrity-initial-items-empty" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerItems
    ) ;
    :assertion _:emptyItems ;
.

_:core-data_resources-data-resource-range-request-suffix-status
    :name "data-resource-range-request-suffix-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceLastBytes
    ) ;
    :assertion _:206 ;
.

_:getStorageRoot
    :name "Get storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "baseUri" ;
            ] ;
            :relative [
                :value "/" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            :param "storageRoot" ;
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
        ]
    ) ;
.

_:createResource
    :name "Create resource" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "newResource" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedResource
    :name "Get created resource" ;
    :request [
        :method "GET" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:deleteCreatedResource
    :name "Delete created resource" ;
    :request [
        :method "DELETE" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:createContainer
    :name "Create test container" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
        :headers [
            :header "Link" ;
            :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "containerLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedContainer
    :name "Get test container" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Accept" ;
            :value "application/lws+json" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:404
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "404" ;
.

_:200
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "200" ;
.

_:999
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "999" ;
.

_:createTextResource
    :name "Create text resource in test container" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Content-Type" ;
            :value "text/plain" ;
        ] ;
        :body "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
    :extractors (
        [
            :param "textResourceLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getTextResourceBody
    :name "Get text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "textResourceLocation" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            a :BodyExtractor ;
            :param "body" ;
        ]
    ) ;
.

_:shoppingListBody
    :type "EqualityAssertion" ;
    :param "body" ;
    :value "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
.

_:createDigitsResource
    :name "Create ten-byte text resource in test container" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Content-Type" ;
            :value "text/plain" ;
        ] ;
        :body "0123456789" ;
    ] ;
    :extractors (
        [
            :param "digitsResourceLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getDigitsResourceBeyondEnd
    :name "Get range beyond end of text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Range" ;
            :value "bytes=100-200" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:416
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "416" ;
.

_:createSubContainer
    :name "Create sub-container in test container" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Link" ;
            :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "containerLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:emptyItems
    :type "EqualityAssertion" ;
    :param "items" ;
    :value "[]" ;
.

_:getDigitsResourceFirstBytes
    :name "Get first four bytes of text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Range" ;
            :value "bytes=0-3" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:206
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "206" ;
.

_:getContainerItems
    :name "Get items of container" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Accept" ;
            :value "application/lws+json" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "items" ;
            :path "$.items" ;
        ]
    ) ;
.

_:getDigitsResourceLastBytes
    :name "Get last two bytes of text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Range" ;
            :value "bytes=-2" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.
