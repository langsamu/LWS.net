@prefix : <http://example.com/> .

[
    :name "LWS Test Suite" ;
    :tests (
        _:test1
        _:test2
        _:core-containers-getContainer-status
        _:core-data_resources-createDataResource-body
        _:core-data_resources-data-resource-range-unsatisfiable
        _:core-containers-createContainer-items-empty
        _:core-data_resources-data-resource-range-request-first-status
        _:core-containers-getContainer-containmentIntegrity-initial-items-empty
        _:core-data_resources-data-resource-range-request-suffix-status
        _:core-data_resources-data-resource-head-parity-head-body-empty
        _:core-containers-container-head-parity-head-body-empty
        _:core-data_resources-create-server-managed-links-protected-post-status
        _:core-containers-container-conneg-weighted-status
        _:core-containers-container-ld-json-lws-profile-status
        _:core-containers-container-conneg-vary
        _:core-data_resources-data-resource-accept-ranges
        _:core-data_resources-data-resource-range-request-suffix-body
        _:core-data_resources-data-resource-range-request-first-content-range
        _:core-data_resources-data-resource-range-request-first-body
        _:core-data_resources-create-in-missing-container-404
        _:core-data_resources-create-in-missing-container-rejected-items-empty
        _:core-data_resources-create-post-twice-distinct-first-body
        _:core-data_resources-create-post-twice-distinct-second-body
        _:core-data_resources-post-to-non-container-405-status
        _:core-data_resources-error-problem-details-status
        _:core-data_resources-error-problem-details-content-type
        _:core-data_resources-readDataResource-status
        _:core-data_resources-readDataResource-content-type
        _:core-data_resources-readDataResource-etag
        _:core-data_resources-data-resource-head-parity-head-status
        _:core-data_resources-data-resource-head-parity-head-content-type
        _:core-containers-createContainer-content-type
        _:core-containers-container-head-parity-head-status
        _:core-containers-container-head-parity-head-content-type
        _:core-discovery-discovery-storage-description-default-media-type
        _:core-discovery-discovery-storage-description-status
        _:core-discovery-discovery-storage-description-content-type
        _:core-discovery-discovery-storage-description-context-cid
        _:core-discovery-discovery-storage-description-context-lws
    ) ;
] .

_:test1
    :name "Deleted resource returns 404" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
        _:getCreatedResource
    ) ;
    :assertion _:404 ;
.

_:test2
    :name "Delete returns 999 (intentionally failing)" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
    ) ;
    :assertion _:999 ; # Intentionally bogus
.

_:core-containers-getContainer-status
    :name "Container GET returns 200" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
    ) ;
    :assertion _:200 ;
.

_:core-data_resources-createDataResource-body
    :name "Created data resource returns posted body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceBody
    ) ;
    :assertion [
        :param "body" ;
        :value "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
.

_:core-data_resources-data-resource-range-unsatisfiable
    :name "Range beyond end returns 416" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceBeyondEnd
    ) ;
    :assertion _:416 ;
.

_:core-containers-createContainer-items-empty
    :name "New nested container has no items" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createSubContainer
        _:getContainerItems
    ) ;
    :assertion _:emptyItems ;
.

_:core-data_resources-data-resource-range-request-first-status
    :name "Byte range returns 206" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceFirstBytes
    ) ;
    :assertion _:206 ;
.

_:core-containers-getContainer-containmentIntegrity-initial-items-empty
    :name "New container has no items" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerItems
    ) ;
    :assertion _:emptyItems ;
.

_:core-data_resources-data-resource-range-request-suffix-status
    :name "Suffix byte range returns 206" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceLastBytes
    ) ;
    :assertion _:206 ;
.

_:core-data_resources-data-resource-head-parity-head-body-empty
    :name "Data resource HEAD returns no body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceBody
    ) ;
    :assertion _:emptyBody ;
.

_:core-containers-container-head-parity-head-body-empty
    :name "Container HEAD returns no body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
        _:headContainerBody
    ) ;
    :assertion _:emptyBody ;
.

_:core-data_resources-create-server-managed-links-protected-post-status
    :name "Create with forged linkset Link returns 201" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createResourceWithForgedLinkset
    ) ;
    :assertion _:201 ;
.

_:core-containers-container-conneg-weighted-status
    :name "Container GET with weighted Accept returns 200" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerWithWeightedAccept
    ) ;
    :assertion _:200 ;
.

_:core-containers-container-ld-json-lws-profile-status
    :name "Container GET as JSON-LD with LWS profile returns 200" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerWithLwsProfileAccept
    ) ;
    :assertion _:200 ;
.

_:core-containers-container-conneg-vary
    :name "Container response varies by Accept" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerVary
    ) ;
    :assertion [
        :param "vary" ;
        :regex "(?i)(^|[\\s,])accept($|[\\s,])" ;
    ] ;
.

_:core-data_resources-data-resource-accept-ranges
    :name "Data resource advertises byte ranges" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceAcceptRanges
    ) ;
    :assertion [
        :param "acceptRanges" ;
        :regex "(?i)\\bbytes\\b" ;
    ] ;
.

_:core-data_resources-data-resource-range-request-suffix-body
    :name "Suffix byte range returns last bytes" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceLastBytesBody
    ) ;
    :assertion [
        :param "body" ;
        :regex "^89$" ;
    ] ;
.

_:core-data_resources-data-resource-range-request-first-content-range
    :name "Byte range returns Content-Range" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceFirstBytesContentRange
    ) ;
    :assertion [
        :param "contentRange" ;
        :regex "^bytes 0-3/10$" ;
    ] ;
.

_:core-data_resources-data-resource-range-request-first-body
    :name "Byte range returns requested bytes" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceFirstBytesBody
    ) ;
    :assertion [
        :param "body" ;
        :regex "^0123$" ;
    ] ;
.

_:getStorageRoot
    :name "Discover storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "baseUri" ;
            ] ;
            :relative [
                :value "/" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            :param "storageRoot" ;
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
        ]
    ) ;
.

_:createResource
    :name "Create resource" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "newResource" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedResource
    :name "Get resource status" ;
    :request [
        :method "GET" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:deleteCreatedResource
    :name "Delete resource" ;
    :request [
        :method "DELETE" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:createContainer
    :name "Create container" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
        :headers _:linkTypeContainer ;
    ] ;
    :extractors (
        _:containerLocation
    ) ;
.

_:containerLocation
    :param "containerLocation" ;
    :header "Location" ;
.

_:getCreatedContainer
    :name "Get container status" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:404
    :param "status" ;
    :value "404" ;
.

_:200
    :param "status" ;
    :value "200" ;
.

_:999
    :param "status" ;
    :value "999" ;
.

_:createTextResource
    :name "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
    :extractors (
        [
            :param "textResourceLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getTextResourceBody
    :name "Get text resource body" ;
    :request [
        :method "GET" ;
        :uri _:textResource ;
    ] ;
    :extractors (
        _:body
    ) ;
.

_:body
    a :BodyExtractor ;
    :param "body" ;
.

_:createDigitsResource
    :name "Create digits resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "0123456789" ;
    ] ;
    :extractors (
        [
            :param "digitsResourceLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getDigitsResourceBeyondEnd
    :name "Get digits resource beyond end status" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers [
            :header "Range" ;
            :value "bytes=100-200" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:digitsResource
    :base [
        :param "storageRoot" ;
    ] ;
    :relative [
        :param "digitsResourceLocation" ;
    ] ;
.

_:416
    :param "status" ;
    :value "416" ;
.

_:createSubContainer
    :name "Create nested container" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:linkTypeContainer ;
    ] ;
    :extractors (
        _:containerLocation
    ) ;
.

_:emptyItems
    :param "items" ;
    :value "[]" ;
.

_:getDigitsResourceFirstBytes
    :name "Get digits resource first four bytes status" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers _:rangeFirstFourBytes ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:rangeFirstFourBytes
    :header "Range" ;
    :value "bytes=0-3" ;
.

_:206
    :param "status" ;
    :value "206" ;
.

_:getContainerItems
    :name "Get container items" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        [
            :param "items" ;
            :path "$.items" ;
        ]
    ) ;
.

_:getDigitsResourceLastBytes
    :name "Get digits resource last two bytes status" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers _:rangeLastTwoBytes ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:rangeLastTwoBytes
    :header "Range" ;
    :value "bytes=-2" ;
.

_:headTextResourceBody
    :name "Head text resource body" ;
    :request [
        :method "HEAD" ;
        :uri _:textResource ;
    ] ;
    :extractors (
        _:body
    ) ;
.

_:emptyBody
    :param "body" ;
    :value "" ;
.

_:headContainerBody
    :name "Head container body" ;
    :request [
        :method "HEAD" ;
        :uri _:container ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        _:body
    ) ;
.

_:linkTypeContainer
    :header "Link" ;
    :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
.

_:acceptLwsJson
    :header "Accept" ;
    :value "application/lws+json" ;
.

_:contentTypeTextPlain
    :header "Content-Type" ;
    :value "text/plain" ;
.

_:createResourceWithForgedLinkset
    :name "Create resource with forged linkset" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers
            _:contentTypeTextPlain ,
            [
                :header "Link" ;
                :value "<https://linkset.invalid/forged>; rel=\"linkset\"" ;
            ] ;
        :body "metadata override attempt" ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:201
    :param "status" ;
    :value "201" ;
.

_:getContainerWithWeightedAccept
    :name "Get container with weighted Accept status" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers [
            :header "Accept" ;
            :value "text/html;q=0.9, application/ld+json;q=0.5" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:status
    a :StatusCodeExtractor ;
    :param "status" ;
.

_:getContainerWithLwsProfileAccept
    :name "Get container with LWS profile Accept status" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers [
            :header "Accept" ;
            :value "application/ld+json; profile=\"https://www.w3.org/ns/lws/v1\"" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:getContainerVary
    :name "Get container Vary" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        [
            :param "vary" ;
            :header "Vary" ;
        ]
    ) ;
.

_:getDigitsResourceAcceptRanges
    :name "Get digits resource Accept-Ranges" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
    ] ;
    :extractors (
        [
            :param "acceptRanges" ;
            :header "Accept-Ranges" ;
        ]
    ) ;
.

_:getDigitsResourceLastBytesBody
    :name "Get digits resource last two bytes body" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers _:rangeLastTwoBytes ;
    ] ;
    :extractors (
        _:body
    ) ;
.

_:getDigitsResourceFirstBytesContentRange
    :name "Get digits resource first four bytes Content-Range" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers _:rangeFirstFourBytes ;
    ] ;
    :extractors (
        [
            :param "contentRange" ;
            :header "Content-Range" ;
        ]
    ) ;
.

_:getDigitsResourceFirstBytesBody
    :name "Get digits resource first four bytes body" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers _:rangeFirstFourBytes ;
    ] ;
    :extractors (
        _:body
    ) ;
.

_:core-data_resources-create-in-missing-container-404
    :name "Create in missing container returns 404" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:postToMissingContainer
    ) ;
    :assertion _:404 ;
.

_:postToMissingContainer
    :name "Create resource in missing container" ;
    :request [
        :method "POST" ;
        :uri [
            :base _:container ;
            :relative [
                :value "missing-container/" ;
            ] ;
        ] ;
        :headers _:contentTypeTextPlain ;
        :body "lost letter" ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:core-data_resources-create-in-missing-container-rejected-items-empty
    :name "Rejected create leaves container empty" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:postToMissingContainer
        _:getContainerItems
    ) ;
    :assertion _:emptyItems ;
.

_:core-data_resources-create-post-twice-distinct-first-body
    :name "First of two identical creates keeps its body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createFirstSameBytesResource
        _:createSecondSameBytesResource
        _:getFirstSameBytesResourceBody
    ) ;
    :assertion _:sameBytesBody ;
.

_:createFirstSameBytesResource
    :name "Create first same-bytes resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "same bytes" ;
    ] ;
    :extractors (
        [
            :param "firstSameBytesLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:createSecondSameBytesResource
    :name "Create second same-bytes resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "same bytes" ;
    ] ;
    :extractors (
        [
            :param "secondSameBytesLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getFirstSameBytesResourceBody
    :name "Get first same-bytes resource body" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "firstSameBytesLocation" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        _:body
    ) ;
.

_:sameBytesBody
    :param "body" ;
    :regex "^same bytes$" ;
.

_:core-data_resources-create-post-twice-distinct-second-body
    :name "Second of two identical creates keeps its body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createFirstSameBytesResource
        _:createSecondSameBytesResource
        _:getSecondSameBytesResourceBody
    ) ;
    :assertion _:sameBytesBody ;
.

_:getSecondSameBytesResourceBody
    :name "Get second same-bytes resource body" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "secondSameBytesLocation" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        _:body
    ) ;
.

_:core-data_resources-post-to-non-container-405-status
    :name "Create beneath data resource returns 405" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createNotAContainerResource
        _:postBeneathDataResource
    ) ;
    :assertion _:405 ;
.

_:createNotAContainerResource
    :name "Create data resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "not a container" ;
    ] ;
    :extractors (
        [
            :param "notAContainerLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:postBeneathDataResource
    :name "Create resource beneath data resource" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "notAContainerLocation" ;
            ] ;
        ] ;
        :headers _:contentTypeTextPlain ;
        :body "should be refused" ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:405
    :param "status" ;
    :value "405" ;
.

_:core-data_resources-error-problem-details-status
    :name "Missing resource returns 404" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getMissingResource
    ) ;
    :assertion _:404 ;
.

_:getMissingResource
    :name "Get missing resource status" ;
    :request [
        :method "GET" ;
        :uri _:missingResource ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:missingResource
    :base _:container ;
    :relative [
        :value "missing-resource" ;
    ] ;
.

_:core-data_resources-error-problem-details-content-type
    :name "Missing resource returns problem details" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getMissingResourceContentType
    ) ;
    :assertion [
        :param "contentType" ;
        :regex "(?i)^application/problem\\+json\\s*(;|$)" ;
    ] ;
.

_:getMissingResourceContentType
    :name "Get missing resource Content-Type" ;
    :request [
        :method "GET" ;
        :uri _:missingResource ;
    ] ;
    :extractors (
        _:contentType
    ) ;
.

_:contentType
    :param "contentType" ;
    :header "Content-Type" ;
.

_:core-data_resources-readDataResource-status
    :name "Data resource GET returns 200" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceStatus
    ) ;
    :assertion _:200 ;
.

_:getTextResourceStatus
    :name "Get text resource status" ;
    :request [
        :method "GET" ;
        :uri _:textResource ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:textResource
    :base [
        :param "storageRoot" ;
    ] ;
    :relative [
        :param "textResourceLocation" ;
    ] ;
.

_:core-data_resources-readDataResource-content-type
    :name "Data resource GET returns its media type" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceContentType
    ) ;
    :assertion _:textPlainContentType ;
.

_:getTextResourceContentType
    :name "Get text resource Content-Type" ;
    :request [
        :method "GET" ;
        :uri _:textResource ;
    ] ;
    :extractors (
        _:contentType
    ) ;
.

_:textPlainContentType
    :param "contentType" ;
    :regex "(?i)^text/plain\\s*(;|$)" ;
.

_:core-data_resources-readDataResource-etag
    :name "Data resource GET returns ETag" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceEtag
    ) ;
    :assertion [
        :param "etag" ;
        :regex "." ;
    ] ;
.

_:getTextResourceEtag
    :name "Get text resource ETag" ;
    :request [
        :method "GET" ;
        :uri _:textResource ;
    ] ;
    :extractors (
        [
            :param "etag" ;
            :header "ETag" ;
        ]
    ) ;
.

_:core-data_resources-data-resource-head-parity-head-status
    :name "Data resource HEAD returns 200" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceStatus
    ) ;
    :assertion _:200 ;
.

_:headTextResourceStatus
    :name "Head text resource status" ;
    :request [
        :method "HEAD" ;
        :uri _:textResource ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:core-data_resources-data-resource-head-parity-head-content-type
    :name "Data resource HEAD returns its media type" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceContentType
    ) ;
    :assertion _:textPlainContentType ;
.

_:headTextResourceContentType
    :name "Head text resource Content-Type" ;
    :request [
        :method "HEAD" ;
        :uri _:textResource ;
    ] ;
    :extractors (
        _:contentType
    ) ;
.

_:core-containers-createContainer-content-type
    :name "Nested container GET returns LWS media type" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createSubContainer
        _:getContainerContentType
    ) ;
    :assertion _:lwsJsonContentType ;
.

_:getContainerContentType
    :name "Get container Content-Type" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        _:contentType
    ) ;
.

_:container
    :base [
        :param "storageRoot" ;
    ] ;
    :relative [
        :param "containerLocation" ;
    ] ;
.

_:lwsJsonContentType
    :param "contentType" ;
    :regex "(?i)^application/lws\\+json\\s*(;|$)" ;
.

_:core-containers-container-head-parity-head-status
    :name "Container HEAD returns 200" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
        _:headContainerStatus
    ) ;
    :assertion _:200 ;
.

_:headContainerStatus
    :name "Head container status" ;
    :request [
        :method "HEAD" ;
        :uri _:container ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:core-containers-container-head-parity-head-content-type
    :name "Container HEAD returns LWS media type" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
        _:headContainerContentType
    ) ;
    :assertion _:lwsJsonContentType ;
.

_:headContainerContentType
    :name "Head container Content-Type" ;
    :request [
        :method "HEAD" ;
        :uri _:container ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        _:contentType
    ) ;
.

_:core-discovery-discovery-storage-description-default-media-type
    :name "Storage description defaults to CID media type" ;
    :steps (
        _:getStorageDescriptionContentType
    ) ;
    :assertion _:lwsCidContentType ;
.

_:getStorageDescriptionContentType
    :name "Get storage description Content-Type" ;
    :request [
        :method "GET" ;
        :uri _:storage ;
    ] ;
    :extractors (
        _:contentType
    ) ;
.

_:storage
    :base [
        :param "baseUri" ;
    ] ;
    :relative [
        :value "/" ;
    ] ;
.

_:lwsCidContentType
    :param "contentType" ;
    :regex "(?i)^application/lws\\+cid\\s*(;|$)" ;
.

_:core-discovery-discovery-storage-description-status
    :name "Storage description as CID returns 200" ;
    :steps (
        _:getStorageDescriptionAsCidStatus
    ) ;
    :assertion _:200 ;
.

_:getStorageDescriptionAsCidStatus
    :name "Get storage description as CID status" ;
    :request [
        :method "GET" ;
        :uri _:storage ;
        :headers _:acceptLwsCid ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:acceptLwsCid
    :header "Accept" ;
    :value "application/lws+cid" ;
.

_:core-discovery-discovery-storage-description-content-type
    :name "Storage description as CID returns CID media type" ;
    :steps (
        _:getStorageDescriptionAsCidContentType
    ) ;
    :assertion _:lwsCidContentType ;
.

_:getStorageDescriptionAsCidContentType
    :name "Get storage description as CID Content-Type" ;
    :request [
        :method "GET" ;
        :uri _:storage ;
        :headers _:acceptLwsCid ;
    ] ;
    :extractors (
        _:contentType
    ) ;
.

_:core-discovery-discovery-storage-description-context-cid
    :name "Storage description first context is CID" ;
    :steps (
        _:getStorageDescriptionFirstContext
    ) ;
    :assertion [
        :param "context" ;
        :value "https://www.w3.org/ns/cid/v1" ;
    ] ;
.

_:getStorageDescriptionFirstContext
    :name "Get storage description first context" ;
    :request [
        :method "GET" ;
        :uri _:storage ;
        :headers _:acceptLwsCid ;
    ] ;
    :extractors (
        [
            :param "context" ;
            :path "$['@context'][0]" ;
        ]
    ) ;
.

_:core-discovery-discovery-storage-description-context-lws
    :name "Storage description second context is LWS" ;
    :steps (
        _:getStorageDescriptionSecondContext
    ) ;
    :assertion [
        :param "context" ;
        :value "https://www.w3.org/ns/lws/v1" ;
    ] ;
.

_:getStorageDescriptionSecondContext
    :name "Get storage description second context" ;
    :request [
        :method "GET" ;
        :uri _:storage ;
        :headers _:acceptLwsCid ;
    ] ;
    :extractors (
        [
            :param "context" ;
            :path "$['@context'][1]" ;
        ]
    ) ;
.
