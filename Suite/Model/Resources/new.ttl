@prefix : <http://example.com/> .

[
    :name "LWS Test Suite" ;
    :tests (
        _:test1
        _:test2
        _:core-containers-getContainer-status
        _:core-data_resources-createDataResource-body
        _:core-data_resources-data-resource-range-unsatisfiable
        _:core-containers-createContainer-items-empty
        _:core-data_resources-data-resource-range-request-first-status
        _:core-containers-getContainer-containmentIntegrity-initial-items-empty
        _:core-data_resources-data-resource-range-request-suffix-status
        _:core-data_resources-data-resource-head-parity-head-body-empty
        _:core-containers-container-head-parity-head-body-empty
        _:core-data_resources-create-server-managed-links-protected-post-status
        _:core-containers-container-conneg-weighted-status
        _:core-containers-container-ld-json-lws-profile-status
        _:core-containers-container-conneg-vary
        _:core-data_resources-data-resource-accept-ranges
        _:core-data_resources-data-resource-range-request-suffix-body
    ) ;
] .

_:test1
    :name "Test1" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
        _:getCreatedResource
    ) ;
    :assertion _:404 ;
.

_:test2
    :name "Test2" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
    ) ;
    :assertion _:999 ; # Intentionally bogus
.

_:core-containers-getContainer-status
    :name "getContainer-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
    ) ;
    :assertion _:200 ;
.

_:core-data_resources-createDataResource-body
    :name "createDataResource-body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceBody
    ) ;
    :assertion _:shoppingListBody ;
.

_:core-data_resources-data-resource-range-unsatisfiable
    :name "Data resource range unsatisfiable" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceBeyondEnd
    ) ;
    :assertion _:416 ;
.

_:core-containers-createContainer-items-empty
    :name "createContainer-items-empty" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createSubContainer
        _:getContainerItems
    ) ;
    :assertion _:emptyItems ;
.

_:core-data_resources-data-resource-range-request-first-status
    :name "data-resource-range-request-first-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceFirstBytes
    ) ;
    :assertion _:206 ;
.

_:core-containers-getContainer-containmentIntegrity-initial-items-empty
    :name "getContainer-containmentIntegrity-initial-items-empty" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerItems
    ) ;
    :assertion _:emptyItems ;
.

_:core-data_resources-data-resource-range-request-suffix-status
    :name "data-resource-range-request-suffix-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceLastBytes
    ) ;
    :assertion _:206 ;
.

_:core-data_resources-data-resource-head-parity-head-body-empty
    :name "data-resource-head-parity-head-body-empty" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceBody
    ) ;
    :assertion _:emptyBody ;
.

_:core-containers-container-head-parity-head-body-empty
    :name "container-head-parity-head-body-empty" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
        _:headContainerBody
    ) ;
    :assertion _:emptyBody ;
.

_:core-data_resources-create-server-managed-links-protected-post-status
    :name "create-server-managed-links-protected-post-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createResourceWithForgedLinkset
    ) ;
    :assertion _:201 ;
.

_:core-containers-container-conneg-weighted-status
    :name "container-conneg-weighted-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerWithWeightedAccept
    ) ;
    :assertion _:200 ;
.

_:core-containers-container-ld-json-lws-profile-status
    :name "container-ld-json-lws-profile-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerWithLwsProfileAccept
    ) ;
    :assertion _:200 ;
.

_:core-containers-container-conneg-vary
    :name "container-conneg-vary" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getContainerVary
    ) ;
    :assertion _:variesByAccept ;
.

_:core-data_resources-data-resource-accept-ranges
    :name "data-resource-accept-ranges" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceAcceptRanges
    ) ;
    :assertion _:advertisesBytesRanges ;
.

_:core-data_resources-data-resource-range-request-suffix-body
    :name "data-resource-range-request-suffix-body" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceLastBytesBody
    ) ;
    :assertion [
        :param "body" ;
        :regex "^89$" ;
    ] ;
.

_:getStorageRoot
    :name "Get storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "baseUri" ;
            ] ;
            :relative [
                :value "/" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            :param "storageRoot" ;
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
        ]
    ) ;
.

_:createResource
    :name "Create resource" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "newResource" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedResource
    :name "Get created resource" ;
    :request [
        :method "GET" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:deleteCreatedResource
    :name "Delete created resource" ;
    :request [
        :method "DELETE" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:createContainer
    :name "Create test container" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
        :headers _:linkTypeContainer ;
    ] ;
    :extractors (
        [
            :param "containerLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedContainer
    :name "Get test container" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:404
    :param "status" ;
    :value "404" ;
.

_:200
    :param "status" ;
    :value "200" ;
.

_:999
    :param "status" ;
    :value "999" ;
.

_:createTextResource
    :name "Create text resource in test container" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers _:contentTypeTextPlain ;
        :body "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
    :extractors (
        [
            :param "textResourceLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getTextResourceBody
    :name "Get text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "textResourceLocation" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            a :BodyExtractor ;
            :param "body" ;
        ]
    ) ;
.

_:shoppingListBody
    :param "body" ;
    :value "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
.

_:createDigitsResource
    :name "Create ten-byte text resource in test container" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers _:contentTypeTextPlain ;
        :body "0123456789" ;
    ] ;
    :extractors (
        [
            :param "digitsResourceLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getDigitsResourceBeyondEnd
    :name "Get range beyond end of text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Range" ;
            :value "bytes=100-200" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:416
    :param "status" ;
    :value "416" ;
.

_:createSubContainer
    :name "Create sub-container in test container" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers _:linkTypeContainer ;
    ] ;
    :extractors (
        [
            :param "containerLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:emptyItems
    :param "items" ;
    :value "[]" ;
.

_:getDigitsResourceFirstBytes
    :name "Get first four bytes of text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Range" ;
            :value "bytes=0-3" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:206
    :param "status" ;
    :value "206" ;
.

_:getContainerItems
    :name "Get items of container" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        [
            :param "items" ;
            :path "$.items" ;
        ]
    ) ;
.

_:getDigitsResourceLastBytes
    :name "Get last two bytes of text resource" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Range" ;
            :value "bytes=-2" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:headTextResourceBody
    :name "Head text resource" ;
    :request [
        :method "HEAD" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "textResourceLocation" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            a :BodyExtractor ;
            :param "body" ;
        ]
    ) ;
.

_:emptyBody
    :param "body" ;
    :value "" ;
.

_:headContainerBody
    :name "Head container" ;
    :request [
        :method "HEAD" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        [
            a :BodyExtractor ;
            :param "body" ;
        ]
    ) ;
.

_:linkTypeContainer
    :header "Link" ;
    :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
.

_:acceptLwsJson
    :header "Accept" ;
    :value "application/lws+json" ;
.

_:contentTypeTextPlain
    :header "Content-Type" ;
    :value "text/plain" ;
.

_:createResourceWithForgedLinkset
    :name "Create resource claiming a forged linkset" ;
    :request [
        :method "POST" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers
            _:textPlainHeader ,
            [
                :header "Link" ;
                :value "<https://linkset.invalid/forged>; rel=\"linkset\"" ;
            ] ;
        :body "metadata override attempt" ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:201
    :param "status" ;
    :value "201" ;
.

_:getContainerWithWeightedAccept
    :name "Get container with weighted Accept" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Accept" ;
            :value "text/html;q=0.9, application/ld+json;q=0.5" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:status
    a :StatusCodeExtractor ;
    :param "status" ;
.

_:getContainerWithLwsProfileAccept
    :name "Get container with LWS profile Accept" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Accept" ;
            :value "application/ld+json; profile=\"https://www.w3.org/ns/lws/v1\"" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:getContainerVary
    :name "Get container Vary header" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "containerLocation" ;
            ] ;
        ] ;
        :headers _:acceptLwsJson ;
    ] ;
    :extractors (
        [
            :param "vary" ;
            :header "Vary" ;
        ]
    ) ;
.

_:variesByAccept
    :param "vary" ;
    :regex "(?i)(^|[\\s,])accept($|[\\s,])" ;
.

_:getDigitsResourceAcceptRanges
    :name "Get text resource Accept-Ranges header" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            :param "acceptRanges" ;
            :header "Accept-Ranges" ;
        ]
    ) ;
.

_:advertisesBytesRanges
    :param "acceptRanges" ;
    :regex "(?i)\\bbytes\\b" ;
.

_:getDigitsResourceLastBytesBody
    :name "Get last two bytes of text resource body" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "digitsResourceLocation" ;
            ] ;
        ] ;
        :headers [
            :header "Range" ;
            :value "bytes=-2" ;
        ] ;
    ] ;
    :extractors (
        [
            a :BodyExtractor ;
            :param "body" ;
        ]
    ) ;
.
