@prefix : <http://example.com/> .

[
    :name "LWS Test Suite" ;
    :tests (
        _:test1
        _:test2
        _:core-containers-getContainer-status
    ) ;
] .

_:test1
    :name "Test1" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
        _:getCreatedResource
    ) ;
    :assertion _:404 ;
.

_:test2
    :name "Test2" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
    ) ;
    :assertion _:999 ; # Intentionally bogus
.

_:core-containers-getContainer-status
    :name "getContainer-status" ;
    :steps (
        _:getStorageRoot
        _:createContainer
        _:getCreatedContainer
    ) ;
    :assertion _:200 ;
.

_:getStorageRoot
    :name "Get storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "baseUri" ;
            ] ;
            :relative [
                :value "/" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            :param "storageRoot" ;
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
        ]
    ) ;
.

_:createResource
    :name "Create resource" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "newResource" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedResource
    :name "Get created resource" ;
    :request [
        :method "GET" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:deleteCreatedResource
    :name "Delete created resource" ;
    :request [
        :method "DELETE" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:createContainer
    :name "Create test container" ;
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
        :headers (
            [
                :header "Link" ;
                :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
            ]
        ) ;
    ] ;
    :extractors (
        [
            :param "testContainerLocation" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedContainer
    :name "Get test container" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "storageRoot" ;
            ] ;
            :relative [
                :param "testContainerLocation" ;
            ] ;
        ] ;
        :headers (
            [
                :header "Accept" ;
                :value "application/lws+json" ;
            ]
        ) ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:404
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "404" ;
.

_:200
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "200" ;
.

_:999
    :type "EqualityAssertion" ;
    :param "status" ;
    :value "999" ;
.
