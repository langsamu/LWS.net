@prefix : <http://example.com/> .

[
    :name "LWS Test Suite" ;
    :tests (
        _:test1
        _:test2
        _:core-containers-getContainer-status
    ) ;
] .

_:test1
    :name "Test1" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
        _:getCreatedResource
    ) ;
    :assertion [
        :type "EqualityAssertion" ;
        :param "status" ;
        :value "404" ;
    ] ;
.

_:test2
    :name "Test2" ;
    :steps (
        _:getStorageRoot
        _:createResource
        _:getCreatedResource
        _:deleteCreatedResource
    ) ;
    :assertion [
        :type "EqualityAssertion" ;
        :param "status" ;
        :value "999" ;
    ] .

_:core-containers-getContainer-status
    :name "getContainer-status" ;
    :steps (
        _:getStorageRoot
        [
            :request [
                :method "POST" ;
                :uri [
                    :param "storageRoot" ;
                ] ;
                :headers (
                    [
                        :header "Link" ;
                        :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
                    ]
                ) ;
            ] ;
            :extractors (
                [
                    :param "testContainerLocation" ;
                    :header "Location" ;
                ]
            ) ;
        ]
        [
            :request [
                :method "GET" ;
                :uri [
                    :base [
                        :param "storageRoot" ;
                    ] ;
                    :relative [
                        :param "testContainerLocation" ;
                    ] ;
                ] ;
                :headers (
                    [
                        :header "Accept" ;
                        :value "application/lws+json" ;
                    ]
                ) ;
            ] ;
            :extractors (
                [
                    a :StatusCodeExtractor ;
                    :param "status" ;
                ]
            ) ;
        ]
    ) ;
    :assertion [
        :type "EqualityAssertion" ;
        :param "status" ;
        :value "200" ;
    ] ;
.

_:getStorageRoot
    :request [
        :method "GET" ;
        :uri [
            :base [
                :param "baseUri" ;
            ] ;
            :relative [
                :value "/" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            :param "storageRoot" ;
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
        ]
    ) ;
.

_:createResource
    :request [
        :method "POST" ;
        :uri [
            :param "storageRoot" ;
        ] ;
    ] ;
    :extractors (
        [
            :param "newResource" ;
            :header "Location" ;
        ]
    ) ;
.

_:getCreatedResource
    :request [
        :method "GET" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.

_:deleteCreatedResource
    :request [
        :method "DELETE" ;
        :uri [
            :param "newResource" ;
        ] ;
    ] ;
    :extractors (
        [
            a :StatusCodeExtractor ;
            :param "status" ;
        ]
    ) ;
.