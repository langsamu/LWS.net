@prefix : <http://example.com/> .

[
    :manifestName "Touchstone: Container reads: Container representation" ;
    :test
        _:containerGetReturnsItemsArray ,
        _:containerGetReturnsItsUri ,
        _:containerGetReturnsTotalItems ,
        _:containerTotalItemsCountsBothMembers ,
        _:containerGetReturnsContainerType ,
        _:nestedContainerGetReturnsContainerType ,
        _:storageRootGetReturnsContainerType ,
        _:containerLwsProfileLdJsonIsomorphic ,
        _:containerLwsProfileTurtleIsomorphic ;
] .

# Tests

_:containerGetReturnsItemsArray
    :testName "Container GET returns items array" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerItems
    ) ;
    :assert _:itemsArray ;
.

_:containerGetReturnsItsUri
    :testName "Container GET returns its URI" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerId
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "id" ;
                ] ;
            ] ;
        ] ;
        :equals _:container ;
    ] ;
.

_:containerGetReturnsTotalItems
    :testName "Container GET returns totalItems" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerTotalItems
    ) ;
    :assert [
        :that [
            :single [
                :variable "totalItems" ;
            ] ;
        ] ;
        :matches [ :constant "^[0-9]+$" ] ;
    ] ;
.

_:containerTotalItemsCountsBothMembers
    :testName "Container totalItems counts both members" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:createSecondTextResource
        _:getContainerTotalItems
    ) ;
    :assert [
        :that [
            :single [
                :variable "totalItems" ;
            ] ;
        ] ;
        :equals [ :constant "2" ] ;
    ] ;
.

_:containerGetReturnsContainerType
    :testName "Container GET returns Container type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerType
    ) ;
    :assert _:containerType ;
.

_:nestedContainerGetReturnsContainerType
    :testName "Nested container GET returns Container type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createNestedContainer
        _:getContainerType
    ) ;
    :assert _:containerType ;
.

_:storageRootGetReturnsContainerType
    :testName "Storage root GET returns Container type" ;
    :steps (
        _:discoverStorageRoot
        _:getStorageRootType
    ) ;
    :assert _:containerType ;
.

_:containerLwsProfileLdJsonIsomorphic
    :testName "Container as JSON-LD in the LWS profile is isomorphic with application/lws+json" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:createOuterContainer
        _:getContainerAsLdJsonProfile
        _:getContainerAsLwsJson
    ) ;
    :assert [
        :that [ :variable "profiled" ] ;
        :isomorphicWith [ :variable "reference" ] ;
    ] ;
.

_:containerLwsProfileTurtleIsomorphic
    :testName "Container as Turtle in the LWS profile is isomorphic with application/lws+json" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:createOuterContainer
        _:getContainerAsTurtleProfile
        _:getContainerAsLwsJson
    ) ;
    :assert [
        :that [ :variable "profiled" ] ;
        :isomorphicWith [ :variable "reference" ] ;
    ] ;
.

# Steps

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :variable "baseUri" ;
        ] ;
    ] ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
        _:upLinks
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "textResourceLocation" ;
        ]
        _:status
        _:linksetLinks
        _:upLinks
    ) ;
.

_:createSecondTextResource
    :stepName "Create second text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "secondTextResourceLocation" ;
        ]
    ) ;
.

_:createNestedContainer
    :stepName "Create nested container" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
        _:status
        _:typeLinks
    ) ;
.

_:getContainerItems
    :stepName "Get container items" ;
    :request _:getContainer ;
    :extract (
        _:items
    ) ;
.

_:getContainerId
    :stepName "Get container id" ;
    :request _:getContainer ;
    :extract (
        _:id
    ) ;
.

_:getContainerTotalItems
    :stepName "Get container total items" ;
    :request _:getContainer ;
    :extract (
        _:totalItems
    ) ;
.

_:getContainerType
    :stepName "Get container type" ;
    :request _:getContainer ;
    :extract (
        _:type
    ) ;
.

_:getStorageRootType
    :stepName "Get storage root type" ;
    :request _:getStorageRoot ;
    :extract (
        _:type
    ) ;
.

_:getContainerAsLdJsonProfile
    :stepName "Get container as JSON-LD in the LWS profile" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers [
            :key "Accept" ;
            :value [ :constant "application/ld+json; profile=\"https://www.w3.org/ns/lws/v1\", application/lws+json;q=0.1" ] ;
        ] ;
    ] ;
    :extract (
        _:profiledGraph
    ) ;
.

_:getContainerAsTurtleProfile
    :stepName "Get container as Turtle in the LWS profile" ;
    :request [
        :method "GET" ;
        :uri _:container ;
        :headers [
            :key "Accept" ;
            :value [ :constant "text/turtle; profile=\"https://www.w3.org/ns/lws/v1\", application/lws+json;q=0.1" ] ;
        ] ;
    ] ;
    :extract (
        _:profiledGraph
    ) ;
.

_:getContainerAsLwsJson
    :stepName "Get container as application/lws+json" ;
    :request _:getContainer ;
    :extract (
        _:referenceGraph
    ) ;
.

_:createOuterContainer
    :stepName "Create outer container" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "outerLocation" ;
        ]
    ) ;
.

# Requests

_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getStorageRoot
    :method "GET" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

# URIs

_:storageRoot
    :single [
        :variable "storageRoot" ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

# Headers

_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

# Extractors

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:profiledGraph
    a :GraphExtractor ;
    :to "profiled" ;
.

_:referenceGraph
    a :GraphExtractor ;
    :to "reference" ;
.

_:type
    :path "$.type" ;
    :to "type" ;
.

_:items
    :path "$.items" ;
    :to "items" ;
.

_:id
    :path "$.id" ;
    :to "id" ;
.

_:totalItems
    :path "$.totalItems" ;
    :to "totalItems" ;
.

_:typeLinks
    :link "type" ;
    :to "typeLinks" ;
.

_:linksetLinks
    :link "linkset" ;
    :to "linksetLinks" ;
.

_:upLinks
    :link "up" ;
    :to "upLinks" ;
.

# Assertions

_:containerType
    :that [
        :single [
            :variable "type" ;
        ] ;
    ] ;
    :matches [ :constant "^Container$|\"Container\"" ] ;
.

_:itemsArray
    :that [
        :single [
            :variable "items" ;
        ] ;
    ] ;
    :matches [ :constant "^\\[" ] ;
.
