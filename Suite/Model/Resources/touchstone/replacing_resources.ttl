@prefix : <http://example.com/> .

[
    :manifestName "Touchstone: Replacing resources" ;
    :test
        _:putDataResourceReturns200Or204 ,
        _:putDataResourceReplacesContent ;
] .

# Tests

_:putDataResourceReturns200Or204
    :testName "PUT replaces a data resource with 200 or 204" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceETag
        _:conditionalPutTextResourceIfMatchStatus
    ) ;
    :assert [
        :that [ :variable "status" ] ;
        :matches [ :constant "^(200|204)$" ] ;
    ] ;
.

_:putDataResourceReplacesContent
    :testName "PUT replaces the data resource content exactly" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceETag
        _:conditionalPutTextResourceIfMatchStatus
        _:getTextResourceBody
    ) ;
    :assert [
        :that [
            :variable "body" ;
        ] ;
        :matches [ :constant "^second content$" ] ;
    ] ;
.

# Steps

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :variable "baseUri" ;
        ] ;
    ] ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
        _:upLinks
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "textResourceLocation" ;
        ]
        _:status
        _:linksetLinks
        _:upLinks
    ) ;
.

_:getTextResourceBody
    :stepName "Get text resource body" ;
    :request _:getTextResource ;
    :extract (
        _:body
    ) ;
.

_:getTextResourceETag
    :stepName "Get text resource ETag" ;
    :request _:getTextResource ;
    :extract (
        [
            :header "ETag" ;
            :to "etag" ;
        ]
    ) ;
.

_:conditionalPutTextResourceIfMatchStatus
    :stepName "Conditional put text resource If-Match status" ;
    :request _:conditionalPutTextResourceIfMatch ;
    :extract (
        _:status
    ) ;
.

# Requests

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:conditionalPutTextResourceIfMatch
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :headers [
        :key "If-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
    :body [ :constant "second content" ] ;
.

# URIs

_:storageRoot
    :single [
        :variable "storageRoot" ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

# Headers

_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

# Extractors

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:body
    a :BodyExtractor ;
    :to "body" ;
.

_:linksetLinks
    :link "linkset" ;
    :to "linksetLinks" ;
.

_:upLinks
    :link "up" ;
    :to "upLinks" ;
.
