.

_:containedDataResourceDescriptionTypeEqualsOrContainsDataResource
    :testName "Contained data resource description type equals or contains DataResource" ;
    :specification "https://www.w3.org/TR/lws10-core/#contained-resource-description"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getContainerItemTypes
    ) ;
    :assert [
        :that [
            :single [
                :variable "itemTypes" ;
            ] ;
        ] ;
