@prefix : <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    :manifestName "From specification: Linked Web Storage Protocol 1.0" ;
    :test
        _:storageDescriptionHasIdProperty ,
        _:storageDescriptionIdIsCanonicalStorageUri ,
        _:storageDescriptionHasTypeProperty ,
        _:storageDescriptionTypeIsOrContainsStorage ,
        _:storageDescriptionHasServiceProperty ,
        _:storageDescriptionServicesContainStorageRoot ,
        _:storageRootServiceEndpointIsUri ,
        _:storageDescriptionServiceEntriesHaveTypeProperty ,
        _:storageDescriptionServiceEntriesHaveServiceEndpointProperty ,
        _:getDataResourceLinksStorage ,
        _:getContainerLinksStorage ,
        _:headDataResourceLinksStorage ,
        _:headContainerLinksStorage ,
        _:getStorageDescriptionLinksStorage ,
        _:getStorageUriReturns200 ,
        _:getStorageUriReturnsLwsCid ,
        _:storageDescriptionSerializableAsLwsCid ,
        _:storageRootServiceEndpointIsStorageRootContainer ,
        _:storageDescriptionContextStartsWithCidAndLws ,
        _:headStorageDescriptionLinksStorage ,
        _:getStorageRootContainerLinksStorage ,
        _:headStorageRootContainerLinksStorage ,
        _:getNonRootDataResourceLinksParentContainerAsUp ,
        _:getNonRootContainerLinksParentContainerAsUp ,
        _:headNonRootDataResourceLinksParentContainerAsUp ,
        _:headNonRootContainerLinksParentContainerAsUp ,
        _:createdResourceIsAddedToContainerItems ,
        _:deletedResourceIsRemovedFromParentContainerItems ,
        _:containerRepresentationIncludesAllContainedResources ,
        _:serverRejectsDeletionOfNonEmptyContainerWithoutRecursionRequestedWith409Conflict ,
        _:createdContainerIsAddedToParentContainerItems ,
        _:getNestedContainerLinksParentContainerAsUp ,
        _:containerRepresentationHasIdProperty ,
        _:containerRepresentationIdIsUriOfContainer ,
        _:containerRepresentationTypeIsContainer ,
        _:containerRepresentationTotalItemsIsInteger ,
        _:containerRepresentationItemsIsArrayOfContainedResourceDescriptions ,
        _:emptyContainerItemsIsEmptyArray ,
        _:containedResourceDescriptionHasIdProperty ,
        _:containedResourceDescriptionIdIsUriOfContainedResource ,
        _:containedDataResourceDescriptionTypeEqualsOrContainsDataResource ,
        _:containedContainerDescriptionTypeEqualsOrContainsContainer ,
        _:containedDataResourceDescriptionFormatIsMediaTypeOfDataResource ,
        _:metadataLinksAreAvailableAsStandaloneResource ,
        _:containerMetadataLinksAreAvailableAsStandaloneResource ,
        _:linksetIsDiscoverableViaLinkHeaderWithRelLinkset ,
        _:containerLinksetIsDiscoverableViaLinkHeaderWithRelLinkset ,
        _:linksetResourceIsAvailableAsApplicationLinksetJson ,
        _:linksetResourceBodyIsRfc9264Linkset ,
        _:allowHeaderOfLinksetAdvertisesGet ,
        _:allowHeaderOfLinksetAdvertisesPatch ,
        _:acceptPatchHeaderOfLinksetAdvertisesJsonPatch ,
        _:linksetGetResponseIncludesEtagHeader ,
        _:linksetHeadResponseIncludesEtagHeader ,
        _:linksetResourceSupportsPatchUsingApplicationJsonPatchJson ,
        _:serverPreservesLinksClientIsNotPermittedToModifyWhenApplyingPatch ,
        _:deletingResourceRemovesItsAssociatedLinksetResource ,
        _:serverManagedMetadataIsGeneratedAutomaticallyUponCreation ,
        _:serverManagedUpLinkIsNotOverriddenByClientProvidedLink ,
        _:serverManagedLinksetLinkIsNotOverriddenByClientProvidedLink ,
        _:successfulCreationReturns201StatusCode ,
        _:successfulCreationReturnsNewUriInLocationHeader ,
        _:createdResourceCanBeRetrievedUsingGetOnItsNewUri ,
        _:createResponseIncludesLinkHeaderWithRelUp ,
        _:createResponseLinkHeaderWithRelUpTargetsParentContainer ,
        _:createResponseIncludesLinkHeaderWithRelLinkset ,
        _:dataResourceIsCreatedWithContentFromRequestBody ,
        _:postWithLinkHeaderWithRelTypeContainerCreatesContainer ,
        _:containerCreationResponseLinkRelUpTargetsParentContainer ,
        _:containerCreationResponseIncludesLinkHeaderWithRelLinkset ,
        _:linksetResourceIsCreatedAndPopulatedBeforeReturningSuccess ,
        _:serverGeneratesUniqueIdentifierWhenNoHintIsProvided ,
        _:getDataResourceReturnsContentTypeMatchingStoredMediaType ,
        _:getDataResourceResponseIncludesLinkHeaderWithRelType ,
        _:serverSupportsRangeRequestsStatus206 ,
        _:serverSupportsRangeRequestsRequestedBytes ,
        _:serverSupportsRangeRequestsContentRange ,
        _:getDataResourceResponseIncludesEtagHeader ,
        _:getContainerResponseIncludesEtagHeader ,
        _:getContainerResponseLinkHeaderWithRelTypeIndicatesContainer ,
        _:headContainerLinkHeaderWithRelTypeIndicatesContainer ,
        _:serverSupportsHeadForDataResources ,
        _:serverSupportsHeadForContainers ,
        _:headDataResourceReturnsSameContentTypeHeaderAsGet ,
        _:headContainerReturnsSameContentTypeHeaderAsGet ,
        _:headDataResourceReturnsSameEtagHeaderAsGet ,
        _:headContainerReturnsSameEtagHeaderAsGet ,
        _:headDataResourceReturnsSameLinkHeaderWithRelLinksetAsGet ,
        _:headContainerReturnsSameLinkHeaderWithRelLinksetAsGet ,
        _:putOnResourceUriHasNoDefaultImpactOnAssociatedLinksetResource ,
        _:putOnResourceUriWithLinkHeaderSucceeds ,
        _:patchOnResourceUriHasNoDefaultImpactOnAssociatedLinksetResource ,
        _:patchOnResourceUriWithLinkHeaderSucceeds ,
        _:serverIgnoresPreferSetLinksetOrRespondsWith501NotImplemented ,
        _:putToResourceUriReplacesFullResourceWithNewContent ,
        _:successfulPutRespondsWith200OkOr204NoContent ,
        _:putWithMatchingIfMatchReplacesContentWithProvidedJson ,
        _:putWithNonMatchingIfMatchRespondsWith412PreconditionFailed ,
        _:patchWithInvalidPayloadRespondsWith400BadRequest ,
        _:serverMinimallySupportsJsonPatchApplicationJsonPatchJson ,
        _:linksetPatchWithFailingPreconditionIsRejectedWith412PreconditionFailed ,
        _:putIsIdempotentForExistingResources ,
        _:onSuccessDeleteRespondsWith204NoContent ,
        _:serverRemovesResourceContentOnDelete ,
        _:onSuccessDeleteOfContainerRespondsWith204NoContent ,
        _:deleteWithMatchingIfMatchRespondsWith204NoContent ,
        _:deletedContainerIsRemovedFromParentContainerItems ;
] .

# Tests

_:storageDescriptionHasIdProperty
    :testName "Storage description has id property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :single [
                :variable "id" ;
            ] ;
        ] ;
        :matches [ :constant "^[A-Za-z][A-Za-z0-9+.-]*:" ] ;
    ] ;
.

_:storageDescriptionIdIsCanonicalStorageUri
    :testName "Storage description id is canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :base _:storage ;
            :relative [
                :single [
                    :variable "id" ;
                ] ;
            ] ;
        ] ;
        :equals _:storage ;
    ] ;
.

_:storageDescriptionHasTypeProperty
    :testName "Storage description has type property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^(?!\\[\\s*\\]$).+" ] ;
    ] ;
.

_:storageDescriptionTypeIsOrContainsStorage
    :testName "Storage description type equals or contains Storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^Storage$|\"Storage\"" ] ;
    ] ;
.

_:storageDescriptionHasServiceProperty
    :testName "Storage description has service property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionServices
    ) ;
    :assert [
        :that [
            :count [
                :variable "services" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageDescriptionServicesContainStorageRoot
    :testName "Storage description services contain StorageRoot" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-services"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :count [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageRootServiceEndpointIsUri
    :testName "StorageRoot serviceEndpoint is URI" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :single [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :matches [ :constant "^https?://.+" ] ;
    ] ;
.

_:storageDescriptionServiceEntriesHaveTypeProperty
    :testName "Storage description service entries have type property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getServicesWhenAllHaveType
    ) ;
    :assert [
        :that [
            :count [
                :variable "servicesAllHavingType" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageDescriptionServiceEntriesHaveServiceEndpointProperty
    :testName "Storage description service entries have serviceEndpoint property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getServicesWhenAllHaveServiceEndpoint
    ) ;
    :assert [
        :that [
            :count [
                :variable "servicesAllHavingServiceEndpoint" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:getDataResourceLinksStorage
    :testName "GET data resource links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getContainerLinksStorage
    :testName "GET container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:headDataResourceLinksStorage
    :testName "HEAD data resource links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:headContainerLinksStorage
    :testName "HEAD container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:headContainerStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getStorageDescriptionLinksStorage
    :testName "GET storage description links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getStorageUriReturns200
    :testName "GET storage URI returns 200" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionStatus
    ) ;
    :assert _:200 ;
.

_:getStorageUriReturnsLwsCid
    :testName "GET storage URI returns application/lws+cid" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionContentType
    ) ;
    :assert _:lwsCidContentType ;
.

_:storageDescriptionSerializableAsLwsCid
    :testName "Storage description serializable as application/lws+cid" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-representation"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionAsCidContentType
    ) ;
    :assert _:lwsCidContentType ;
.

_:storageRootServiceEndpointIsStorageRootContainer
    :testName "StorageRoot serviceEndpoint is storage root container" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-services"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:getStorageRootType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^Container$|\"Container\"" ] ;
    ] ;
.

_:storageDescriptionContextStartsWithCidAndLws
    :testName "Storage description @context starts with CID and LWS URIs" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-representation"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionAsCidContext
    ) ;
    :assert [
        :that [
            :single [
                :variable "context" ;
            ] ;
        ] ;
        :matches [ :constant "^\\[\\s*\"https://www\\.w3\\.org/ns/cid/v1\"\\s*,\\s*\"https://www\\.w3\\.org/ns/lws/v1\"" ] ;
    ] ;
.

_:headStorageDescriptionLinksStorage
    :testName "HEAD storage description links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:headStorageDescriptionStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getStorageRootContainerLinksStorage
    :testName "GET storage root container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:getStorageRootStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:headStorageRootContainerLinksStorage
    :testName "HEAD storage root container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:headStorageRootStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getNonRootDataResourceLinksParentContainerAsUp
    :testName "GET non-root data resource links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:getNonRootContainerLinksParentContainerAsUp
    :testName "GET non-root container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:storageRoot ;
    ] ;
.

_:headNonRootDataResourceLinksParentContainerAsUp
    :testName "HEAD non-root data resource links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:headNonRootContainerLinksParentContainerAsUp
    :testName "HEAD non-root container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:headContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:storageRoot ;
    ] ;
.

_:createdResourceIsAddedToContainerItems
    :testName "Created resource is added to container items" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "itemIds" ;
                ] ;
            ] ;
        ] ;
        :equals _:textResource ;
    ] ;
.

_:deletedResourceIsRemovedFromParentContainerItems
    :testName "Deleted resource is removed from parent container items" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:createSecondTextResource
        _:deleteTextResource
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "itemIds" ;
                ] ;
            ] ;
        ] ;
        :equals _:secondTextResource ;
    ] ;
.

_:containerRepresentationIncludesAllContainedResources
    :testName "Container representation includes identifiers of all contained resources" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-membership-and-authorization"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:createSecondTextResource
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :count [
                :variable "itemIds" ;
            ] ;
        ] ;
        :equals [ :constant 2 ] ;
    ] ;
.

_:serverRejectsDeletionOfNonEmptyContainerWithoutRecursionRequestedWith409Conflict
    :testName "Server rejects deletion of non-empty container without recursion requested with 409 Conflict" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:deleteContainer
    ) ;
    :assert [
        :that [
            :variable "status" ;
        ] ;
        :equals [ :constant "409" ] ;
    ] ;
.

_:createdContainerIsAddedToParentContainerItems
    :testName "Created container is added to parent container items" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createNestedContainer
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "itemIds" ;
                ] ;
            ] ;
        ] ;
        :equals _:nestedContainer ;
    ] ;
.

_:getNestedContainerLinksParentContainerAsUp
    :testName "GET nested container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createNestedContainer
        _:getNestedContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:containerRepresentationHasIdProperty
    :testName "Container representation has id property" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerId
    ) ;
    :assert [
        :that [
            :single [
                :variable "containerId" ;
            ] ;
        ] ;
        :matches [ :constant ".+" ] ;
    ] ;
.

_:containerRepresentationIdIsUriOfContainer
    :testName "Container representation id is URI of container" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerId
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "containerId" ;
                ] ;
            ] ;
        ] ;
        :equals _:container ;
    ] ;
.

_:containerRepresentationTypeIsContainer
    :testName "Container representation type is Container" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerType
    ) ;
    :assert [
        :that [
            :single [
                :variable "containerType" ;
            ] ;
        ] ;
        :equals [ :constant "Container" ] ;
    ] ;
.

_:containerRepresentationTotalItemsIsInteger
    :testName "Container representation totalItems is integer" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerTotalItems
    ) ;
    :assert [
        :that [
            :single [
                :variable "totalItems" ;
            ] ;
        ] ;
        :matches [ :constant "^\\d+$" ] ;
    ] ;
.

_:containerRepresentationItemsIsArrayOfContainedResourceDescriptions
    :testName "Container representation items is an array of contained resource descriptions" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getContainerItemsArray
    ) ;
    :assert [
        :that [
            :single [
                :variable "itemsArray" ;
            ] ;
        ] ;
        :matches [ :constant "^\\[\\s*\\{" ] ;
    ] ;
.

_:emptyContainerItemsIsEmptyArray
    :testName "Empty container items is an empty array" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerItemsArray
    ) ;
    :assert [
        :that [
            :single [
                :variable "itemsArray" ;
            ] ;
        ] ;
        :matches [ :constant "^\\[\\s*\\]$" ] ;
    ] ;
.

_:containedResourceDescriptionHasIdProperty
    :testName "Contained resource description has id property" ;
    :specification "https://www.w3.org/TR/lws10-core/#contained-resource-description"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
