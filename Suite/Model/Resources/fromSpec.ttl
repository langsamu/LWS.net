        :matches [ :constant "^(200|204|501)$" ] ;
    ] ;
.

_:putToResourceUriReplacesFullResourceWithNewContent
    :testName "PUT to resource URI replaces full resource with new content" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:putTextResourceReplacingContent
        _:getTextResourceBody
    ) ;
    :assert [
        :that [
            :variable "body" ;
        ] ;
        :equals [ :constant "new content" ] ;
    ] ;
.

_:successfulPutRespondsWith200OkOr204NoContent
    :testName "Successful PUT responds with 200 OK or 204 No Content" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:putTextResourceReplacingContent
    ) ;
    :assert [
        :that [
            :variable "status" ;
        ] ;
        :matches [ :constant "^(200|204)$" ] ;
    ] ;
.

_:putWithMatchingIfMatchReplacesContentWithProvidedJson
    :testName "PUT with matching If-Match replaces content with provided JSON" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createJsonResource
        _:getJsonResourceEtag
        _:putJsonResourceReplacingContent
        _:getJsonResourceCity
    ) ;
    :assert [
        :that [
            :single [
                :variable "city" ;
            ] ;
        ] ;
        :equals [ :constant "New London" ] ;
    ] ;
.

_:putWithNonMatchingIfMatchRespondsWith412PreconditionFailed
    :testName "PUT with non-matching If-Match responds with 412 Precondition Failed" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:putTextResourceReplacingContentWithBogusIfMatch
    ) ;
    :assert _:412 ;
.

_:patchWithInvalidPayloadRespondsWith400BadRequest
    :testName "PATCH with invalid payload responds with 400 Bad Request" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createJsonResource
        _:patchJsonResourceWithInvalidPayload
    ) ;
    :assert _:400 ;
.

_:serverMinimallySupportsJsonPatchApplicationJsonPatchJson
    :testName "Server minimally supports JSON Patch application/json-patch+json" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createJsonResource
        _:patchJsonResourceReplacingValue
        _:getJsonResourceAValue
    ) ;
    :assert [
        :that [
            :single [
                :variable "a" ;
            ] ;
        ] ;
        :equals [ :constant "2" ] ;
    ] ;
.

_:linksetPatchWithFailingPreconditionIsRejectedWith412PreconditionFailed
    :testName "Linkset PATCH with failing precondition is rejected with 412 Precondition Failed" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:patchLinksetAddingDescribedByWithBogusIfMatch
    ) ;
    :assert _:412 ;
.

_:putIsIdempotentForExistingResources
    :testName "PUT is idempotent for existing resources" ;
    :specification "https://www.w3.org/TR/lws10-core/#update-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:putTextResourceReplacingContent
        _:putTextResourceReplacingContent
    ) ;
    :assert [
        :that [
            :variable "status" ;
        ] ;
        :matches [ :constant "^(200|204)$" ] ;
    ] ;
.

_:onSuccessDeleteRespondsWith204NoContent
    :testName "On success DELETE responds with 204 No Content" ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:deleteTextResource
    ) ;
    :assert _:204 ;
.

_:serverRemovesResourceContentOnDelete
    :testName "Server removes resource content on delete" ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:deleteTextResource
        _:getTextResourceStatus
    ) ;
    :assert [
        :that [
            :variable "status" ;
        ] ;
        :matches [ :constant "^(404|410)$" ] ;
    ] ;
.

_:onSuccessDeleteOfContainerRespondsWith204NoContent
    :testName "On success DELETE of container responds with 204 No Content" ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:deleteContainer
    ) ;
    :assert _:204 ;
.

_:deleteWithMatchingIfMatchRespondsWith204NoContent
    :testName "DELETE with matching If-Match responds with 204 No Content" ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceEtag
        _:deleteTextResourceWithMatchingIfMatch
    ) ;
    :assert _:204 ;
.

_:deletedContainerIsRemovedFromParentContainerItems
    :testName "Deleted container is removed from parent container items" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createNestedContainer
        _:deleteNestedContainer
        _:getContainerItemsArray
    ) ;
    :assert [
        :that [
            :single [
                :variable "itemsArray" ;
            ] ;
        ] ;
        :matches [ :constant "^\\[\\s*\\]$" ] ;
    ] ;
.

# Steps
_:getStorageDescriptionId
    :stepName "Get storage description id" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.id" ;
            :to "id" ;
        ]
    ) ;
.

_:getStorageDescriptionType
    :stepName "Get storage description type" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.type" ;
            :to "type" ;
        ]
    ) ;
.

_:getStorageDescriptionServices
    :stepName "Get storage description services" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[*]" ;
            :to "services" ;
        ]
    ) ;
.

_:getServicesWhenAllHaveServiceEndpoint
    :stepName "Get services when all have serviceEndpoint" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?count($.service[?!@.serviceEndpoint]) == 0]" ;
            :to "servicesAllHavingServiceEndpoint" ;
        ]
    ) ;
.

_:getServicesWhenAllHaveType
    :stepName "Get services when all have type" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?count($.service[?!@.type]) == 0]" ;
            :to "servicesAllHavingType" ;
        ]
    ) ;
.

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot' || @.type[?@ == 'StorageRoot']].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

