                :variable "itemIds" ;
            ] ;
        ] ;
        :matches [ :constant ".+" ] ;
    ] ;
.

_:containedResourceDescriptionIdIsUriOfContainedResource
    :testName "Contained resource description id is URI of contained resource" ;
    :specification "https://www.w3.org/TR/lws10-core/#contained-resource-description"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#read-resource"^^xsd:anyURI ;
    :steps (
