    :include "fromSpec/linksets.ttl"^^xsd:anyURI ;
    :include "fromSpec/create_resource.ttl"^^xsd:anyURI ;
    :include "fromSpec/read_resource.ttl"^^xsd:anyURI ;
    :include "fromSpec/update_resource.ttl"^^xsd:anyURI ;
    :include "fromSpec/delete_resource.ttl"^^xsd:anyURI ;
] .
