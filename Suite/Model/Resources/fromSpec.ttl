# Requests
_:getStorageDescription
    :method "GET" ;
    :uri _:storage ;
.

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:headTextResource
    :method "HEAD" ;
    :uri _:textResource ;
.

_:headContainer
    :method "HEAD" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getStorageDescriptionAsCid
    :method "GET" ;
    :uri _:storage ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/lws+cid" ] ;
    ] ;
.

_:getStorageRoot
    :method "GET" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:headStorageDescription
    :method "HEAD" ;
    :uri _:storage ;
.

_:headStorageRoot
    :method "HEAD" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:getNestedContainer
    :method "GET" ;
    :uri _:nestedContainer ;
    :headers _:acceptLwsJson ;
.

_:getLinkset
    :method "GET" ;
    :uri _:linkset ;
    :headers _:acceptLinksetJson ;
.

_:headLinkset
    :method "HEAD" ;
    :uri _:linkset ;
    :headers _:acceptLinksetJson ;
.

_:patchLinksetAddDescribedBy
    :method "PATCH" ;
    :uri _:linkset ;
    :headers _:contentTypeJsonPatch ;
    :headers _:ifMatchEtag ;
    :body [ :constant "[{\"op\":\"add\",\"path\":\"/linkset/0/describedby\",\"value\":[{\"href\":\"https://example.org/schema\"}]}]" ] ;
.

_:patchLinksetRemoveType
    :method "PATCH" ;
    :uri _:linkset ;
    :headers _:contentTypeJsonPatch ;
    :headers _:ifMatchEtag ;
    :body [ :constant "[{\"op\":\"remove\",\"path\":\"/linkset/0/type\"}]" ] ;
.

_:postTextResource
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
.

_:postTextResourceWithForgedUpLink
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :headers _:linkForgedUp ;
    :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
.

_:postTextResourceWithForgedLinksetLink
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :headers _:linkForgedLinkset ;
    :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
.

_:postContainer
    :method "POST" ;
    :uri _:storageRoot ;
    :headers _:linkTypeContainer ;
.

_:getDigitsResourceFirstFourBytes
    :method "GET" ;
    :uri _:digitsResource ;
    :headers _:rangeFirstFourBytes ;
.

_:putTextResourceReplaceContentWithLinkHeader
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :headers _:linkDescribedBy ;
    :body [ :constant "new content" ] ;
.

_:postJsonResource
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeApplicationJson ;
    :body [ :constant "{\"a\":1}" ] ;
.

_:getJsonResource
    :method "GET" ;
    :uri _:jsonResource ;
.

_:patchJsonResourceReplaceValueWithLinkHeader
    :method "PATCH" ;
    :uri _:jsonResource ;
    :headers _:contentTypeJsonPatch ;
    :headers _:linkDescribedBy ;
    :body [ :constant "[{\"op\":\"replace\",\"path\":\"/a\",\"value\":2}]" ] ;
.

_:putTextResourceReplaceContentWithPreferSetLinkset
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :headers _:preferSetLinkset ;
    :headers _:linkDescribedBy ;
    :body [ :constant "new content" ] ;
.

_:putTextResourceReplaceContent
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :body [ :constant "new content" ] ;
.

_:putJsonResourceReplaceContent
    :method "PUT" ;
    :uri _:jsonResource ;
    :headers _:contentTypeApplicationJson ;
    :headers _:ifMatchEtag ;
    :body [ :constant "{\"name\":\"Alice\",\"age\":30,\"city\":\"New London\",\"state\":\"Connecticut\"}" ] ;
.

_:putTextResourceReplaceContentWithBogusIfMatch
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :headers _:ifMatchBogus ;
    :body [ :constant "new content" ] ;
.

_:patchJsonResourceInvalidPayload
    :method "PATCH" ;
    :uri _:jsonResource ;
    :headers _:contentTypeJsonPatch ;
    :body [ :constant "not json" ] ;
.

_:patchJsonResourceReplaceValue
    :method "PATCH" ;
    :uri _:jsonResource ;
    :headers _:contentTypeJsonPatch ;
    :body [ :constant "[{\"op\":\"replace\",\"path\":\"/a\",\"value\":2}]" ] ;
.

_:patchLinksetAddDescribedByWithBogusIfMatch
    :method "PATCH" ;
    :uri _:linkset ;
    :headers _:contentTypeJsonPatch ;
    :headers _:ifMatchBogus ;
    :body [ :constant "[{\"op\":\"add\",\"path\":\"/linkset/0/describedby\",\"value\":[{\"href\":\"https://example.org/schema\"}]}]" ] ;
.

_:deleteTextResourceIfMatchEtag
    :method "DELETE" ;
    :uri _:textResource ;
    :headers _:ifMatchEtag ;
.

# URIs
_:storage
    :variable "baseUri" ;
.

_:storageRoot
    :base _:storage ;
    :relative [
        :single [
            :variable "storageRoot" ;
        ] ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:container ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

_:secondTextResource
    :base _:container ;
    :relative [
        :single [
            :variable "secondTextResourceLocation" ;
        ] ;
    ] ;
.

_:nestedContainer
    :base _:container ;
    :relative [
        :single [
            :variable "nestedContainerLocation" ;
        ] ;
    ] ;
.

_:linkset
    :single [
        :variable "linksetLinks" ;
    ] ;
.

_:digitsResource
    :base _:container ;
    :relative [
        :single [
            :variable "digitsResourceLocation" ;
        ] ;
    ] ;
.

_:jsonResource
    :base _:container ;
    :relative [
        :single [
            :variable "jsonResourceLocation" ;
        ] ;
    ] ;
.

# Headers
_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

_:acceptLinksetJson
    :key "Accept" ;
    :value [ :constant "application/linkset+json" ] ;
.

_:contentTypeJsonPatch
    :key "Content-Type" ;
    :value [ :constant "application/json-patch+json" ] ;
.

_:ifMatchEtag
    :key "If-Match" ;
    :value [
        :single [
            :variable "etag" ;
        ] ;
    ] ;
.

_:linkForgedUp
    :key "Link" ;
    :value [ :constant "<https://example.org/evil>; rel=\"up\"" ] ;
.

_:linkForgedLinkset
    :key "Link" ;
    :value [ :constant "<https://example.org/evil>; rel=\"linkset\"" ] ;
.

_:rangeFirstFourBytes
    :key "Range" ;
    :value [ :constant "bytes=0-3" ] ;
.

_:linkDescribedBy
    :key "Link" ;
    :value [ :constant "<https://example.org/s>; rel=\"describedby\"" ] ;
.

_:contentTypeApplicationJson
    :key "Content-Type" ;
    :value [ :constant "application/json" ] ;
.

_:preferSetLinkset
    :key "Prefer" ;
    :value [ :constant "set-linkset" ] ;
.

_:ifMatchBogus
    :key "If-Match" ;
    :value [ :constant "\"bogus\"" ] ;
.

# Extractors
_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:textResourceLocation
    :header "Location" ;
    :to "textResourceLocation" ;
.

_:storageLinks
    :link "https://www.w3.org/ns/lws#storage" ;
    :to "storageLinks" ;
.

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:contentType
    :header "Content-Type" ;
    :to "contentType" ;
.

_:upLinks
    :link "up" ;
    :to "upLinks" ;
.

_:secondTextResourceLocation
    :header "Location" ;
    :to "secondTextResourceLocation" ;
.

_:nestedContainerLocation
    :header "Location" ;
    :to "nestedContainerLocation" ;
.

_:linksetLinks
    :link "linkset" ;
    :to "linksetLinks" ;
.

_:allow
    :header "Allow" ;
    :to "allow" ;
.

_:acceptPatch
    :header "Accept-Patch" ;
    :to "acceptPatch" ;
.

_:etag
    :header "ETag" ;
    :to "etag" ;
.

_:body
    a :BodyExtractor ;
    :to "body" ;
.

_:typeLinks
    :link "type" ;
    :to "typeLinks" ;
.

_:digitsResourceLocation
    :header "Location" ;
    :to "digitsResourceLocation" ;
.

_:contentRange
    :header "Content-Range" ;
    :to "contentRange" ;
.

_:headContentType
    :header "Content-Type" ;
    :to "headContentType" ;
.

_:headEtag
    :header "ETag" ;
    :to "headEtag" ;
.

_:headLinksetLinks
    :link "linkset" ;
    :to "headLinksetLinks" ;
.

_:jsonResourceLocation
    :header "Location" ;
    :to "jsonResourceLocation" ;
.

# Assertions
_:storageLinkTargetsStorage
    :that [
        :variable "storageLinks" ;
    ] ;
    :contains _:storage ;
.

_:200
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "200" ] ;
.

_:lwsCidContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/lws\\+cid\\s*(;|$)" ] ;
.

_:linksetLink
    :that [
        :count [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :greaterThan [ :constant 0 ] ;
.

_:linksetJsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/linkset\\+json\\s*(;|$)" ] ;
.

_:entityTag
    :that [
        :single [
            :variable "etag" ;
        ] ;
    ] ;
    :matches [ :constant "^(W/)?\"[^\"]*\"$" ] ;
.

_:201
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "201" ] ;
.

_:textPlainContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^text/plain\\s*(;|$)" ] ;
.

_:typeLink
    :that [
        :count [
            :variable "typeLinks" ;
        ] ;
    ] ;
    :greaterThan [ :constant 0 ] ;
.

_:206
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "206" ] ;
.

_:headContentTypeEqualsGetContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :equals [
        :single [
            :variable "headContentType" ;
        ] ;
    ] ;
.

_:headEtagEqualsGetEtag
    :that [
        :single [
            :variable "etag" ;
        ] ;
    ] ;
    :equals [
        :single [
            :variable "headEtag" ;
        ] ;
    ] ;
.

_:headLinksetLinkEqualsGetLinksetLink
    :that [
        :single [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :equals [
        :single [
            :variable "headLinksetLinks" ;
        ] ;
    ] ;
.

_:412
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "412" ] ;
.

_:400
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "400" ] ;
.

_:204
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "204" ] ;
.
